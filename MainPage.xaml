<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="FoodStreetGuide.MainPage"
    Title="Danh sách quán">

    <VerticalStackLayout Padding="20" Spacing="15">

        <Label x:Name="LatLabel"
               Text="Latitude: "
               FontSize="16"/>

        <Label x:Name="LngLabel"
               Text="Longitude: "
               FontSize="16"/>

        <CollectionView x:Name="PoiList">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Stroke="Gray"
                            StrokeThickness="1"
                            Margin="10"
                            Padding="10">
                        <VerticalStackLayout Spacing="4">

                            <Label Text="{Binding Name}"
                                   FontSize="18"
                                   FontAttributes="Bold"/>

                            <Label Text="{Binding Description}"
                                   FontSize="14"/>

                            <Label Text="{Binding DistanceKm, StringFormat='Khoảng cách: {0:F2} km'}"
                                   FontSize="13"
                                   TextColor="Green"/>

                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </VerticalStackLayout>

</ContentPage>