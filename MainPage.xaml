<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:maps="clr-namespace:Microsoft.Maui.Controls.Maps;assembly=Microsoft.Maui.Controls.Maps"
    xmlns:res="clr-namespace:FoodStreetGuide.Resources.Strings"
    x:Class="FoodStreetGuide.MainPage"
    NavigationPage.HasNavigationBar="False">

    <Grid>

        <!-- MAP -->
        <maps:Map
            x:Name="MyMap"
            IsShowingUser="True"
            IsScrollEnabled="True"
            IsZoomEnabled="True"
            MapType="Street"/>

        <!-- SEARCH -->
        <Border
            Margin="15,50,15,0"
            HeightRequest="47"
            BackgroundColor="White"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 30"
            VerticalOptions="Start"
            ZIndex="5">

            <Grid ColumnDefinitions="40,*">

                <Image
                    Source="search.png"
                    HeightRequest="20"
                    WidthRequest="20"
                    VerticalOptions="Center"
                    HorizontalOptions="Center"/>

                <Entry
                    x:Name="SearchEntry"
                    Grid.Column="1"
                    Placeholder="{x:Static res:AppResources.SearchPlaceholder}"
                    TextColor="Black"
                    BackgroundColor="Transparent"
                    TextChanged="SearchBar_TextChanged"/>

            </Grid>

        </Border>

        <!-- GPS INFO -->
        <Label
            x:Name="LatLabel"
            Margin="20,120,0,0"
            TextColor="Black"
            FontSize="12"
            ZIndex="5"/>

        <!-- ZOOM CONTROLS -->
        <VerticalStackLayout
            Margin="0,0,15,350"
            Spacing="10"
            HorizontalOptions="End"
            VerticalOptions="End"
            ZIndex="8">

            <Button
                Text="+"
                FontSize="22"
                FontAttributes="Bold"
                BackgroundColor="White"
                TextColor="Black"
                WidthRequest="45"
                HeightRequest="45"
                CornerRadius="22"
                Clicked="ZoomIn_Clicked"/>

            <Button
                Text="-"
                FontSize="24"
                FontAttributes="Bold"
                BackgroundColor="White"
                TextColor="Black"
                WidthRequest="45"
                HeightRequest="45"
                CornerRadius="22"
                Clicked="ZoomOut_Clicked"/>

        </VerticalStackLayout>

        <!-- BOTTOM PANEL -->
        <Border
            x:Name="BottomPanel"
            BackgroundColor="White"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 30,30,0,0"
            VerticalOptions="Fill"
            Padding="15"
            ZIndex="10">

            <Border.GestureRecognizers>
                <PanGestureRecognizer PanUpdated="OnPanelPan"/>
            </Border.GestureRecognizers>

            <Grid RowDefinitions="Auto,Auto,Auto,*">

                <!-- HANDLE -->
                <BoxView
                    HeightRequest="5"
                    WidthRequest="60"
                    Color="#CCC"
                    HorizontalOptions="Center"
                    CornerRadius="3"/>

                <!-- TITLE -->
                <Label
                    x:Name="TitleLabel"
                    Grid.Row="1"
                    Text="{x:Static res:AppResources.NearbyTitle}"
                    FontSize="18"
                    FontAttributes="Bold"
                    Margin="0,10"/>

                <!-- DETAIL MINI -->
                <Grid Grid.Row="2"
                      Grid.RowSpan="2"
                      x:Name="DetailPanel"
                      IsVisible="False"
                      Margin="0,10"
                      VerticalOptions="Fill">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="30"/>
                    </Grid.ColumnDefinitions>

                    <Image
                        x:Name="DetailImage"
                        HeightRequest="90"
                        WidthRequest="90"
                        Aspect="AspectFill"/>

                    <VerticalStackLayout Grid.Column="1" Margin="10,0">

                        <Label
                            x:Name="DetailDescription"
                            FontSize="13"
                            TextColor="Gray"/>

                        <Label
                            x:Name="DetailDistance"
                            FontSize="13"
                            TextColor="#007AFF"/>

                        <HorizontalStackLayout Spacing="10" Margin="0,8,0,0">

                            <Button
                                Text="{x:Static res:AppResources.Route}"
                                Clicked="RouteButton_Click"
                                BackgroundColor="#007AFF"
                                TextColor="White"/>

                            <Button
                                Text="{x:Static res:AppResources.Favorite}"
                                Clicked="FavoriteButton_Click"
                                BackgroundColor="#EEEEEE"
                                TextColor="Black"/>

                        </HorizontalStackLayout>

                    </VerticalStackLayout>

                    <Button
                        Grid.Column="2"
                        Text="✕"
                        FontSize="16"
                        BackgroundColor="Transparent"
                        TextColor="Gray"
                        WidthRequest="30"
                        HeightRequest="30"
                        VerticalOptions="Start"
                        HorizontalOptions="End"
                        Clicked="ClearSelection_Click"/>

                </Grid>

                <!-- LIST -->
                <CollectionView
                    Grid.Row="3"
                    x:Name="PoiList"
                    SelectionMode="Single"
                    SelectionChanged="PoiList_SelectionChanged">

                    <CollectionView.ItemTemplate>
                        <DataTemplate>

                            <Border
                                Padding="10"
                                Margin="0,6"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 15"
                                BackgroundColor="#F7F7F7">

                                <Grid ColumnDefinitions="90,*">

                                    <Image
                                        Source="{Binding ImageUrl}"
                                        HeightRequest="80"
                                        WidthRequest="80"
                                        Aspect="AspectFill"/>

                                    <VerticalStackLayout
                                        Grid.Column="1"
                                        Margin="10,0">

                                        <Label
                                            Text="{Binding Name}"
                                            FontAttributes="Bold"
                                            FontSize="14"/>

                                        <Label
                                            Text="{Binding Description}"
                                            FontSize="12"
                                            TextColor="Gray"
                                            LineBreakMode="TailTruncation"/>

                                        <Label
                                            Text="{Binding DistanceKm, StringFormat='Khoảng cách {0:F2} km'}"
                                            TextColor="#007AFF"
                                            FontSize="12"/>

                                    </VerticalStackLayout>

                                </Grid>

                            </Border>

                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                </CollectionView>

            </Grid>

        </Border>

        <!-- NÚT CÀI ĐẶT NỔI -->
        <Button
            Text="⚙️"
            FontSize="20"
            WidthRequest="50"
            HeightRequest="50"
            CornerRadius="25"
            BackgroundColor="White"
            TextColor="Black"
            HorizontalOptions="End"
            VerticalOptions="Start"
            Margin="0,100,15,0"
            ZIndex="20"
            Clicked="OnSettingsClicked">

            <Button.Shadow>
                <Shadow Brush="Black"
                        Opacity="0.3"
                        Radius="10"
                        Offset="2,2"/>
            </Button.Shadow>

        </Button>

    </Grid>

</ContentPage>