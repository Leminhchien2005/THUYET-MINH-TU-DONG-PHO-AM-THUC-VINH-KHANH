<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:maps="clr-namespace:Microsoft.Maui.Controls.Maps;assembly=Microsoft.Maui.Controls.Maps"
    x:Class="FoodStreetGuide.MainPage"
    NavigationPage.HasNavigationBar="False">

    <Grid>

        <!-- MAP -->
        <maps:Map
            x:Name="MyMap"
            IsShowingUser="True"
            MapType="Street"/>

        <!-- SEARCH -->
        <Border
            Margin="15,50,15,0"
            HeightRequest="47"
            BackgroundColor="White"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 30"
            VerticalOptions="Start"
            ZIndex="5">

            <Grid ColumnDefinitions="40,*">

                <Image
                    Source="search.png"
                    HeightRequest="20"
                    WidthRequest="20"
                    VerticalOptions="Center"
                    HorizontalOptions="Center"/>

                <Entry
                    x:Name="SearchEntry"
                    Grid.Column="1"
                    Placeholder="Tìm quán ăn..."
                    TextColor="Black"
                    BackgroundColor="Transparent"
                    TextChanged="SearchBar_TextChanged"/>

            </Grid>

        </Border>

        <!-- GPS INFO -->
        <Label
            x:Name="LatLabel"
            Margin="20,120,0,0"
            TextColor="Black"
            FontSize="12"
            ZIndex="5"/>

        <!-- BOTTOM PANEL -->
        <Border
            x:Name="BottomPanel"
            BackgroundColor="White"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 30,30,0,0"
            VerticalOptions="Fill"
            Padding="15"
            ZIndex="10">

            <Border.GestureRecognizers>
                <PanGestureRecognizer PanUpdated="OnPanelPan"/>
            </Border.GestureRecognizers>

            <Grid RowDefinitions="Auto,Auto,Auto,*">

                <!-- HANDLE -->
                <BoxView
                    HeightRequest="5"
                    WidthRequest="60"
                    Color="#CCC"
                    HorizontalOptions="Center"
                    CornerRadius="3"/>

                <!-- TITLE -->
                <Label
                    Grid.Row="1"
                    Text="Quán gần bạn"
                    FontSize="18"
                    FontAttributes="Bold"
                    Margin="0,10"/>

                <!-- DETAIL MINI -->
                <Grid Grid.Row="2"
                      x:Name="DetailPanel"
                      IsVisible="False"
                      Margin="0,10">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Image
                        x:Name="DetailImage"
                        HeightRequest="90"
                        WidthRequest="90"
                        Aspect="AspectFill"/>

                    <VerticalStackLayout Grid.Column="1" Margin="10,0">

                        <Label
                            x:Name="DetailName"
                            FontSize="16"
                            FontAttributes="Bold"/>

                        <Label
                            x:Name="DetailDescription"
                            FontSize="13"
                            TextColor="Gray"/>

                        <Label
                            x:Name="DetailDistance"
                            FontSize="13"
                            TextColor="#007AFF"/>

                        <HorizontalStackLayout Spacing="10" Margin="0,8,0,0">

                            <Button
                                Text="Chỉ đường"
                                Clicked="RouteButton_Click"
                                BackgroundColor="#007AFF"
                                TextColor="White"/>

                            <Button
                                Text="Xem chi tiết"
                                Clicked="DetailButton_Click"
                                BackgroundColor="#EEEEEE"
                                TextColor="Black"/>

                        </HorizontalStackLayout>

                    </VerticalStackLayout>

                </Grid>

                <!-- LIST -->
                <CollectionView
                    Grid.Row="3"
                    x:Name="PoiList"
                    SelectionMode="Single"
                    SelectionChanged="PoiList_SelectionChanged">

                    <CollectionView.ItemTemplate>
                        <DataTemplate>

                            <Border
                                Padding="10"
                                Margin="0,6"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 15"
                                BackgroundColor="#F7F7F7">

                                <Grid ColumnDefinitions="90,*">

                                    <Image
                                        Source="{Binding ImageUrl}"
                                        HeightRequest="80"
                                        WidthRequest="80"
                                        Aspect="AspectFill"/>

                                    <VerticalStackLayout
                                        Grid.Column="1"
                                        Margin="10,0">

                                        <Label
                                            Text="{Binding Name}"
                                            FontAttributes="Bold"
                                            FontSize="14"/>

                                        <Label
                                            Text="{Binding Description}"
                                            FontSize="12"
                                            TextColor="Gray"
                                            LineBreakMode="TailTruncation"/>

                                        <Label
                                            Text="{Binding DistanceKm, StringFormat='Khoảng cách {0:F2} km'}"
                                            TextColor="#007AFF"
                                            FontSize="12"/>

                                    </VerticalStackLayout>

                                </Grid>

                            </Border>

                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                </CollectionView>

            </Grid>

        </Border>

        <!-- FULL DETAIL PANEL -->
        <Grid
            x:Name="DetailFullPanel"
            IsVisible="False"
            BackgroundColor="White"
            ZIndex="20">

            <Button
                Text="✕"
                FontSize="20"
                WidthRequest="40"
                HeightRequest="40"
                HorizontalOptions="End"
                VerticalOptions="Start"
                Margin="10"
                BackgroundColor="Transparent"
                Clicked="CloseDetail_Click"/>

            <ScrollView Margin="0,40,0,0">

                <VerticalStackLayout Spacing="10" Padding="10">

                    <Image
                        x:Name="FullImage"
                        HeightRequest="200"
                        Aspect="AspectFill"/>

                    <Label
                        x:Name="FullName"
                        FontSize="22"
                        FontAttributes="Bold"/>

                    <Label
                        x:Name="FullDescription"
                        FontSize="15"
                        TextColor="Gray"/>

                    <Label
                        x:Name="FullDistance"
                        FontSize="15"
                        TextColor="#007AFF"/>

                    <Button
                        Text="Chỉ đường"
                        Clicked="RouteButton_Click"/>

                </VerticalStackLayout>

            </ScrollView>

        </Grid>

    </Grid>

</ContentPage>