<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:maps="clr-namespace:Microsoft.Maui.Controls.Maps;assembly=Microsoft.Maui.Controls.Maps"
    x:Class="FoodStreetGuide.MainPage"
    NavigationPage.HasNavigationBar="False">

    <Grid>

        <!-- MAP -->
        <maps:Map
            x:Name="MyMap"
            IsShowingUser="True"
            MapType="Street"/>

        <!-- SEARCH -->
        <Border
            Margin="15,50,15,0"
            HeightRequest="47"
            BackgroundColor="White"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 30"
            VerticalOptions="Start"
            ZIndex="5">

            <Grid ColumnDefinitions="40,*">

                <Image
                    Source="search.png"
                    HeightRequest="20"
                    WidthRequest="20"
                    VerticalOptions="Center"
                    HorizontalOptions="Center"/>

                <Entry
                    x:Name="SearchEntry"
                    Grid.Column="1"
                    Placeholder="Tìm quán ăn..."
                    TextColor="Black"
                    BackgroundColor="Transparent"
                    TextChanged="SearchBar_TextChanged"/>

            </Grid>

        </Border>

        <!-- GPS INFO -->
        <Label
            x:Name="LatLabel"
            Margin="20,120,0,0"
            TextColor="black"
            FontSize="12"
            ZIndex="5"/>

        <!-- BOTTOM PANEL -->
        <Border
    x:Name="BottomPanel"
    BackgroundColor="White"
    StrokeThickness="0"
    StrokeShape="RoundRectangle 30,30,0,0"
    VerticalOptions="Fill"
    Padding="15"
    ZIndex="10">

            <Border.GestureRecognizers>
                <PanGestureRecognizer PanUpdated="OnPanelPan"/>
            </Border.GestureRecognizers>

            <Grid RowDefinitions="Auto,Auto,*">

                <!-- HANDLE -->
                <BoxView
            HeightRequest="5"
            WidthRequest="60"
            Color="#CCC"
            HorizontalOptions="Center"
            CornerRadius="3"/>

                <!-- TITLE -->
                <Label
            Grid.Row="1"
            Text="Quán gần bạn"
            FontSize="18"
            FontAttributes="Bold"
            Margin="0,10"/>

                <!-- LIST -->
                <CollectionView
            Grid.Row="2"
            x:Name="PoiList"
            SelectionMode="Single"
            SelectionChanged="PoiList_SelectionChanged">

                    <CollectionView.ItemTemplate>
                        <DataTemplate>

                            <Border
                        Padding="10"
                        Margin="0,6"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 15"
                        BackgroundColor="#F7F7F7">

                                <Grid ColumnDefinitions="90,*">

                                    <Image
                                Source="{Binding ImageUrl}"
                                HeightRequest="80"
                                WidthRequest="80"
                                Aspect="AspectFill"/>

                                    <VerticalStackLayout
                                Grid.Column="1"
                                Margin="10,0">

                                        <Label
                                    Text="{Binding Name}"
                                    FontAttributes="Bold"
                                    FontSize="14"/>

                                        <Label
                                    Text="{Binding Description}"
                                    FontSize="12"
                                    TextColor="Gray"
                                    LineBreakMode="TailTruncation"/>

                                        <Label
                                    Text="{Binding DistanceKm, StringFormat='Khoảng cách {0:F2} km'}"
                                    TextColor="#007AFF"
                                    FontSize="12"/>

                                    </VerticalStackLayout>

                                </Grid>

                            </Border>

                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                </CollectionView>

            </Grid>

        </Border>

    </Grid>

</ContentPage>