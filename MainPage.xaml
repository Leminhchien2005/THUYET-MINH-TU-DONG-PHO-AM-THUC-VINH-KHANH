<ContentPage    
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:maps="clr-namespace:Microsoft.Maui.Controls.Maps;assembly=Microsoft.Maui.Controls.Maps"
    xmlns:res="clr-namespace:FoodStreetGuide.Resources.Strings"
    x:Class="FoodStreetGuide.MainPage"
    NavigationPage.HasNavigationBar="False">

    <Grid>

        <!-- MAP -->
        <maps:Map
            x:Name="MyMap"
            IsShowingUser="True"
            IsScrollEnabled="True"                      
            IsZoomEnabled="True"
            MapType="Street"/>

        <!-- SEARCH -->
        <Border
            Margin="15,50,15,0"
            HeightRequest="47"
            BackgroundColor="White"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 30"
            VerticalOptions="Start"
            ZIndex="5">

            <Grid ColumnDefinitions="40,*">

                <Image
                    Source="search.png"
                    HeightRequest="20"
                    WidthRequest="20"
                    VerticalOptions="Center"
                    HorizontalOptions="Center"/>

                <Entry
                    x:Name="SearchEntry"
                    Grid.Column="1"
                    Placeholder="{x:Static res:AppResources.SearchPlaceholder}"
                    TextColor="Black"
                    BackgroundColor="Transparent"
                    TextChanged="SearchBar_TextChanged"/>

            </Grid>

        </Border>

        <!-- SEARCH PANEL -->
        <Border
            x:Name="SearchPanel"
            Margin="15,105,15,0"
            BackgroundColor="White"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 12"
            VerticalOptions="Start"
            IsVisible="False"
            ZIndex="6">

            <CollectionView
                x:Name="SearchResultsList"
                HeightRequest="220"
                SelectionMode="Single"
                SelectionChanged="SearchResults_SelectionChanged">

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="10" ColumnDefinitions="Auto,*">
                            <Image
                                Source="{Binding ImageUrl}"
                                HeightRequest="40"
                                WidthRequest="40"
                                Aspect="AspectFill"/>
                            <Label
                                Grid.Column="1"
                                Text="{Binding Name}"
                                FontAttributes="Bold"
                                FontSize="13"
                                Margin="10,0,0,0"/>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

        </Border>

        <!-- GPS INFO -->
        <Label
            x:Name="LatLabel"
            Margin="20,120,0,0"
            TextColor="Black"
            FontSize="12"
            ZIndex="5"/>

        <!-- ZOOM CONTROLS -->
        <VerticalStackLayout
            Margin="0,0,15,350"
            Spacing="10"
            HorizontalOptions="End"
            VerticalOptions="End"
            ZIndex="8">

            <Button
                Text="+"
                FontSize="22"
                FontAttributes="Bold"
                BackgroundColor="White"
                TextColor="Black"
                WidthRequest="45"
                HeightRequest="45"
                CornerRadius="22"
                Clicked="ZoomIn_Clicked"/>

            <Button
                Text="-"
                FontSize="24"
                FontAttributes="Bold"
                BackgroundColor="White"
                TextColor="Black"
                WidthRequest="45"
                HeightRequest="45"
                CornerRadius="22"
                Clicked="ZoomOut_Clicked"/>

        </VerticalStackLayout>

        <!-- BOTTOM PANEL -->
        <Border
            x:Name="BottomPanel"
            BackgroundColor="White"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 30,30,0,0"
            VerticalOptions="Fill"
            Padding="15"
            ZIndex="10">

            <Border.GestureRecognizers>
                <PanGestureRecognizer PanUpdated="OnPanelPan"/>
            </Border.GestureRecognizers>

            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,*">

                <!-- HANDLE -->
                <BoxView
                    HeightRequest="5"
                    WidthRequest="60"
                    Color="#CCC"
                    HorizontalOptions="Center"
                    CornerRadius="3"/>

                <!-- TITLE -->
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,10">

                    <!-- TITLE -->
                    <Label 
                        x:Name="TitleLabel"
                        Grid.Column="0"
                        Text="{x:Static res:AppResources.NearbyTitle}"
                        FontSize="18"
                        FontAttributes="Bold"
                        VerticalOptions="Center"/>

                    <!-- CLOSE -->
                    <Button
                        x:Name="TopCloseButton"
                        Grid.Column="1"
                        Text="✕"
                        BackgroundColor="Transparent"
                        TextColor="Gray"
                        IsVisible="False"
                        Clicked="ClearSelection_Click"/>
                </Grid>

                <!-- ROUTE INFO PANEL -->
                <Border
                    Grid.Row="2"
                    x:Name="RouteInfoPanel"
                    BackgroundColor="#F2F2F2"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 12"
                    Padding="10,6"
                    Margin="0,0,0,6"
                    IsVisible="False">

                    <Label
                        x:Name="RouteInfoLabel"
                        FontSize="12"
                        TextColor="Gray"/>
                </Border>

                <!-- DETAIL MINI -->
                <Grid 
                    Grid.Row="3"
                    Grid.RowSpan="5"
                    x:Name="DetailPanel"
                    IsVisible="False"
                    Margin="0,5">

                    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto">

                        <Label
            Grid.Row="0"
            x:Name="DetailDistance"
            FontSize="13"
            TextColor="#007AFF"
            Margin="0,0,0,5"/>

                        <!-- 🔹 ROW 1: ACTION + CLOSE -->
                        <Grid Grid.Row="1"
              ColumnDefinitions="Auto,*,Auto,Auto"
              Margin="0,0,0,5">

                            <!-- ACTION LEFT -->
                            <Button
                Grid.Column="0"
                                x:Name="RouteButton"
                Text="{x:Static res:AppResources.Route}"
                BackgroundColor="#007AFF"
                TextColor="White"
                HeightRequest="32"
                Clicked="RouteButton_Click"/>

                            <!-- PLAY -->
                            <Button
                Grid.Column="2"
                x:Name="PlayButton"
                Text="📢"
                BackgroundColor="#EEEEEE"
                TextColor="Black"
                HeightRequest="32"
                Clicked="PlayButton_Click"/>

                        </Grid>

                        <!-- 🔹 ROW 2: IMAGE -->
                        <Border Grid.Row="2"
                StrokeShape="RoundRectangle 15"
                StrokeThickness="0"
                Margin="0,8">

                            <Image
                x:Name="DetailImage"
                HeightRequest="140"
                Aspect="AspectFill"/>
                        </Border>

                        <Label
            Grid.Row="3"
            x:Name="DetailDescription"
            FontSize="13"
            TextColor="Gray"
            LineBreakMode="TailTruncation"
            MaxLines="3"/>

                    </Grid>

                </Grid>

                <!-- NEARBY LIST -->
                <Label
                    x:Name="NearbyTitleLabel"
                    Grid.Row="4"
                    FontAttributes="Bold"   
                    FontSize="14"
                    Margin="0,4,0,2"/>

                <CollectionView
                    Grid.Row="5"
                    x:Name="NearbyPoiList"
                    HeightRequest="130"
                    Margin="0,0,0,2"
                    SelectionMode="Single"
                    SelectionChanged="PoiList_SelectionChanged">

                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal" ItemSpacing="10"/>
                    </CollectionView.ItemsLayout>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>

                            <Border
                                Padding="10"
                                WidthRequest="260"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 15"
                                BackgroundColor="#F7F7F7">

                                <Grid ColumnDefinitions="90,*">

                                    <Image
                                        Source="{Binding ImageUrl}"
                                        HeightRequest="80"
                                        WidthRequest="80"
                                        Aspect="AspectFill"/>

                                    <VerticalStackLayout
                                        Grid.Column="1"
                                        Margin="10,0">

                                        <Label
                                            Text="{Binding Name}"
                                            FontAttributes="Bold"
                                            FontSize="14"/>

                                        <Label
                                            Text="{Binding Description}"
                                            FontSize="12"
                                            TextColor="Gray"
                                            LineBreakMode="TailTruncation"/>

                                        <Label
                                            Text="{Binding DistanceKm, StringFormat='Khoảng cách {0:F2} km'}"
                                            TextColor="#007AFF"
                                            FontSize="12"/>

                                    </VerticalStackLayout>

                                </Grid>

                            </Border>

                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                </CollectionView>

                <!-- ALL LIST -->
                <Label
                    x:Name="AllTitleLabel"
                    Grid.Row="6"
                    Text="Tất cả quán"
                    FontAttributes="Bold"
                    FontSize="14"
                    Margin="0,30,0,20"/>

                <CollectionView
                    Grid.Row="7"
                    x:Name="AllPoiList"
                    Margin="0,2,0,30"
                    SelectionMode="Single"
                    SelectionChanged="PoiList_SelectionChanged">

                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="10"/>
                    </CollectionView.ItemsLayout>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>

                            <Border
                                Padding="10"
                                WidthRequest="320"
                                HeightRequest="130"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 15"
                                BackgroundColor="#F7F7F7">

                                <Grid ColumnDefinitions="90,*">

                                    <Image
                                        Source="{Binding ImageUrl}"
                                        HeightRequest="80"
                                        WidthRequest="80"
                                        Aspect="AspectFill"/>

                                    <VerticalStackLayout
                                        Grid.Column="1"
                                        Margin="10,0">

                                        <Label
                                            Text="{Binding Name}"
                                            FontAttributes="Bold"
                                            FontSize="14"/>

                                        <Label
                                            Text="{Binding Description}"
                                            FontSize="12"
                                            TextColor="Gray"
                                            LineBreakMode="TailTruncation"/>

                                        <Label
                                            Text="{Binding DistanceKm, StringFormat='Khoảng cách {0:F2} km'}"
                                            TextColor="#007AFF"
                                            FontSize="12"/>

                                    </VerticalStackLayout>

                                </Grid>

                            </Border>

                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                </CollectionView>

            </Grid>

        </Border>

        <!-- NÚT CÀI ĐẶT NỔI -->
        <Button
            Text="⚙️"
            FontSize="20"
            WidthRequest="50"
            HeightRequest="50"
            CornerRadius="25"
            BackgroundColor="White"
            TextColor="Black"
            HorizontalOptions="End"
            VerticalOptions="Start"
            Margin="0,100,15,0"
            ZIndex="9"
            Clicked="OnSettingsClicked">

            <Button.Shadow>
                <Shadow Brush="Black"
                        Opacity="0.3"
                        Radius="10"
                        Offset="2,2"/>
            </Button.Shadow>

        </Button>

    </Grid>

</ContentPage>