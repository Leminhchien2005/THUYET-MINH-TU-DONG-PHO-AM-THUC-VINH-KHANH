<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:maps="clr-namespace:Microsoft.Maui.Controls.Maps;assembly=Microsoft.Maui.Controls.Maps"
    x:Class="FoodStreetGuide.MainPage"
    NavigationPage.HasNavigationBar="False">

    <Grid>

        <!-- GOOGLE MAP -->
        <maps:Map x:Name="MyMap"
                  IsShowingUser="True"
                  MapType="Street" />

        <!-- LATITUDE LABEL -->
        <Label x:Name="LatLabel"
               Text="Latitude: "
               FontSize="16"
               Margin="20,110,0,0"
               VerticalOptions="Start"
               ZIndex="2"/>

        <!-- SEARCH BAR -->
        <Border BackgroundColor="White"
                Padding="10"
                HeightRequest="55"
                Margin="20,50,20,0"
                VerticalOptions="Start"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 30"
                ZIndex="2">

            <Entry x:Name="SearchEntry"
                   Placeholder="Tìm quán ăn..."
                   TextColor="Black"
                   BackgroundColor="Transparent"/>
        </Border>

        <!-- BOTTOM PANEL -->
        <Border BackgroundColor="White"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 30,30,0,0"
                Padding="20"
                HeightRequest="220"
                VerticalOptions="End"
                ZIndex="1">

            <VerticalStackLayout>

                <Label Text="Food Street Guide"
                       TextColor="#1C1C1E"
                       FontSize="20"
                       FontAttributes="Bold"/>

                <CollectionView x:Name="PoiList"
                                HeightRequest="150">

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border BackgroundColor="White"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 15"
                                    Padding="10"
                                    Margin="0,5">

                                <VerticalStackLayout>

                                    <Label Text="{Binding Name}"
                                           TextColor="#2C2C2E"
                                           FontAttributes="Bold"/>

                                    <Label Text="{Binding Description}"
                                           TextColor="Gray"
                                           FontSize="12"/>

                                    <!-- ✅ HIỂN THỊ KHOẢNG CÁCH -->
                                    <Label Text="{Binding DistanceKm, StringFormat='Khoảng cách: {0:F2} km'}"
                                           TextColor="#007AFF"
                                           FontSize="12"/>

                                </VerticalStackLayout>

                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                </CollectionView>

            </VerticalStackLayout>

        </Border>

    </Grid>

</ContentPage>