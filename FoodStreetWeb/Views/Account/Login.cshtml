<h2>Đăng nhập</h2>

@if (TempData["Success"] != null)
{
    <script>
        alert("Đăng ký thành công!");
    </script>
}

<form method="post">

    <input name="email" placeholder="Email" />

    <br />

    <input name="password" type="password" placeholder="Password" />

    <br />

    <button type="submit">Đăng nhập</button>

</form>

@if (ViewBag.Error != null)
{
    <p>@ViewBag.Error</p>
}