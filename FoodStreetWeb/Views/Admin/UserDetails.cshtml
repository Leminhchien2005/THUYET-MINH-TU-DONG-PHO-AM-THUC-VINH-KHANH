@model FoodStreetWeb.Models.ApplicationUser

<h2>Chi tiết tài khoản</h2>

<p><b>Email:</b> @Model.Email</p>
<p><b>Họ tên:</b> @Model.FullName</p>
<p><b>Số điện thoại:</b> @Model.PhoneNumber</p>

@if (ViewBag.Role != "Admin")
{
    <h3>Các quán đang quản lý</h3>

    <table class="table">
        <tr>
            <th>Tên quán</th>
            <th>Mô tả</th>
        </tr>

        @foreach (var poi in ViewBag.Pois)
        {
            <tr>
                <td>@poi.Name</td>
                <td>@poi.Description</td>
            </tr>
        }
    </table>
}