@{
    ViewData["Title"] = "Admin Dashboard";
}

<style>
    .heatmap-wrap {
        position: relative;
    }

    .heat-cell {
        min-width: 52px;
        transition: transform .08s ease, box-shadow .15s ease;
        cursor: default;
    }

    .heat-cell:hover {
        transform: scale(1.03);
        box-shadow: inset 0 0 0 2px rgba(0,0,0,.12);
    }

    .heat-legend {
        display: flex;
        gap: 8px;
        align-items: center;
        flex-wrap: wrap;
    }

    .heat-legend-item {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 12px;
        color: #495057;
    }

    .heat-legend-swatch {
        width: 16px;
        height: 16px;
        border-radius: 4px;
        border: 1px solid rgba(0,0,0,.08);
    }

    #heatTooltip {
        position: fixed;
        pointer-events: none;
        display: none;
        z-index: 1050;
        background: #1f2937;
        color: #fff;
        border-radius: 8px;
        padding: 8px 10px;
        font-size: 12px;
        line-height: 1.35;
        box-shadow: 0 10px 24px rgba(0,0,0,.25);
        max-width: 240px;
    }
</style>

<h3>Dashboard</h3>

<div class="row mb-3">
    <div class="col-md-3">
        <label class="form-label">Nhà hàng</label>
        <select id="restaurantFilter" class="form-select">
            <option value="">Tất cả</option>
        </select>
    </div>
 
    <div class="col-md-3">
        <label class="form-label">Từ ngày</label>
        <input id="fromDate" type="date" class="form-control" />
    </div>

    <div class="col-md-3">
        <label class="form-label">Đến ngày</label>
        <input id="toDate" type="date" class="form-control" />
    </div>

    <div class="col-md-3 d-flex align-items-end gap-2">
        <button id="btnApply" class="btn btn-primary">Áp dụng</button>
        <button id="btnReset" class="btn btn-outline-secondary">Reset</button>
        <button id="btnExportCsv" class="btn btn-success">Export CSV</button>
    </div>
</div>

<div class="row mb-3">
    <div class="col-md-3">
        <div class="card">
            <div class="card-body">
                <div class="text-muted">Số người online trên app</div>
                <div id="onlineUsers" style="font-size: 28px; font-weight: bold;">0</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card">
            <div class="card-body">
                <div class="text-muted">Số người đang truy cập web</div>
                <div id="webOnlineUsers" style="font-size: 28px; font-weight: bold;">0</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card">
            <div class="card-body">
                <div class="text-muted">Tổng lượt quét</div>
                <div id="totalScans" style="font-size: 28px; font-weight: bold;">0</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card">
            <div class="card-body">
                <h6>Top quán</h6>
                <div id="topRestaurants" class="small"></div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="card mb-3">
        <div class="card-body">
            <h6>Phân tích lưu lượng Web & App</h6>

            <div class="row g-2 mb-2">
                <div class="col-md-3 d-none">
                    <div class="border rounded p-2">
                        <small class="text-muted">App Connect</small>
                        <div id="trafficAppConnect" class="fw-bold">0</div>
                    </div>
                </div>
                <div class="col-md-3 d-none">
                    <div class="border rounded p-2">
                        <small class="text-muted">App Disconnect</small>
                        <div id="trafficAppDisconnect" class="fw-bold">0</div>
                    </div>
                </div>
                <div class="col-md-3 d-none">
                    <div class="border rounded p-2">
                        <small class="text-muted">Web Active</small>
                        <div id="trafficWebActive" class="fw-bold">0</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="border rounded p-2">
                        <small class="text-muted">Thiết bị duy nhất (Web/App)</small>
                        <div id="trafficUniqueDevices" class="fw-bold">0 / 0</div>
                    </div>
                </div>
            </div>

            <canvas id="trafficChart" height="120"></canvas>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-6 mb-3">
        <div class="card">
            <div class="card-body">
                <h6>📊 Lượt quét theo ngày (Line)</h6>
                <canvas id="timelineChart" height="130"></canvas>
            </div>
        </div>
    </div>

    <div class="col-lg-6 mb-3">
        <div class="card">
            <div class="card-body">
                <h6>📊 Lượt quét theo giờ (Bar)</h6>
                <canvas id="hourlyChart" height="130"></canvas>
            </div>
        </div>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        <h6>Heatmap đông/vắng</h6>
        <div class="heatmap-wrap">
            <div class="table-responsive">
                <table class="table table-bordered text-center align-middle" id="heatmapTable"></table>
            </div>
            <div id="heatTooltip"></div>
        </div>
        <div class="heat-legend mt-2">
            <span class="heat-legend-item"><span class="heat-legend-swatch" style="background:rgba(59,130,246,.18)"></span>Vắng</span>
            <span class="heat-legend-item"><span class="heat-legend-swatch" style="background:rgba(245,158,11,.35)"></span>Bình thường</span>
            <span class="heat-legend-item"><span class="heat-legend-swatch" style="background:rgba(239,68,68,.60)"></span>Đông</span>
        </div>
        <small class="text-muted">Màu đậm hơn = đông hơn. Nhãn: Đông / Bình thường / Vắng.</small>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        <h6>So sánh giữa 2 ngày</h6>

        <div class="row g-2 mb-2">
            <div class="col-md-4">
                <label class="form-label">Ngày A</label>
                <input id="compareDayA" type="date" class="form-control" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Ngày B</label>
                <input id="compareDayB" type="date" class="form-control" />
            </div>
            <div class="col-md-4 d-flex align-items-end">
                <button id="btnCompare" class="btn btn-outline-primary">So sánh</button>
            </div>
        </div>

        <canvas id="compareChart" height="120"></canvas>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        <h6>Lịch sử Connect / Disconnect</h6>

        <div class="row g-2 mb-2">
            <div class="col-md-4 d-none">
                <label class="form-label">Thiết bị</label>
                <select id="deviceHistoryFilter" class="form-select">
                    <option value="">Tất cả thiết bị</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Nguồn</label>
                <select id="deviceHistorySourceFilter" class="form-select">
                    <option value="">Tất cả</option>
                    <option value="app">App</option>
                    <option value="web">Web</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Từ ngày</label>
                <input id="deviceHistoryFromDate" type="date" class="form-control" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Đến ngày</label>
                <input id="deviceHistoryToDate" type="date" class="form-control" />
            </div>
            <div class="col-md-2 d-flex align-items-end gap-2">
                <button id="btnApplyDeviceHistory" class="btn btn-outline-primary">Lọc</button>
                <button id="btnResetDeviceHistory" class="btn btn-outline-secondary">Reset</button>
            </div>
        </div>

        <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
            <small class="text-muted">Tổng bản ghi: <span id="deviceHistoryCount">0</span></small>

            <div class="d-flex align-items-center gap-2">
                <select id="deviceHistoryPageSize" class="form-select form-select-sm" style="width: auto;">
                    <option value="10">10</option>
                    <option value="20" selected>20</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                </select>
                <label for="deviceHistoryPageSize" class="form-label mb-0 text-muted">/trang</label>

                <button id="btnDeviceHistoryPrev" class="btn btn-sm btn-outline-secondary">←</button>
                <small id="deviceHistoryPageInfo" class="text-muted">Trang 1 / 1</small>
                <button id="btnDeviceHistoryNext" class="btn btn-sm btn-outline-secondary">→</button>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-sm table-striped align-middle" id="deviceHistoryTable">
                <thead>
                    <tr>
                        <th>Thời gian</th>
                        <th>Thiết bị</th>
                        <th>Nguồn</th>
                        <th>Trạng thái</th>
                        <th class="d-none">ConnectionId</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td colspan="5" class="text-muted text-center">Chưa có dữ liệu</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    const apiBase = '/api/ScanAnalytics';
    const poisApi = '/api/PoisApi';
    const devicePresenceApi = '/api/DevicePresence/online-devices';
    const deviceHistoryApi = '/api/DevicePresence/history';
    const deviceHistoryDevicesApi = '/api/DevicePresence/history-devices';
    const trafficOverviewApi = '/api/ScanAnalytics/traffic-overview';
    const webOnlineApi = '/api/Online/count';
    const webDetailOnlineApi = '/api/Online/web-detail-count';
    const days = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'];

    let timelineChart;
    let hourlyChart;
    let compareChart;
    let trafficChart;
    let latestOverview = null;
    let latestPatterns = null;
    let latestHeatmap = null;
    let latestDeviceHistory = null;
    let latestTrafficOverview = null;
    let deviceHistoryPage = 1;
    let deviceHistoryTotalPages = 1;

    function fmtDate(value) {
        const d = new Date(value);
        return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
    }

    function fmtDateTimeVn(value) {
        if (!value) return '';

        const asText = String(value);
        const hasTimezone = /Z$|[+-]\d{2}:?\d{2}$/.test(asText);
        const normalized = hasTimezone ? asText : `${asText}Z`;
        const d = new Date(normalized);

        if (Number.isNaN(d.getTime())) return asText;

        return new Intl.DateTimeFormat('vi-VN', {
            timeZone: 'Asia/Ho_Chi_Minh',
            year: 'numeric',
            month: '2-digit',
            day: '2-digit',
            hour: '2-digit',
            minute: '2-digit',
            second: '2-digit',
            hour12: false
        }).format(d);
    }

    function toUtcIsoFromVietnamDate(dateText, endOfDay = false) {
        if (!dateText) return '';

        const [year, month, day] = dateText.split('-').map(Number);
        const hour = endOfDay ? 23 : 0;
        const minute = endOfDay ? 59 : 0;
        const second = endOfDay ? 59 : 0;

        const utcMs = Date.UTC(year, month - 1, day, hour - 7, minute, second);
        return new Date(utcMs).toISOString();
    }

    function buildQuery(params) {
        const query = new URLSearchParams();
        Object.entries(params).forEach(([k, v]) => {
            if (v !== null && v !== undefined && v !== '') query.append(k, v);
        });
        return query.toString() ? `?${query.toString()}` : '';
    }

    function getFilters() {
        const restaurantId = document.getElementById('restaurantFilter').value;
        const fromDate = document.getElementById('fromDate').value;
        const toDate = document.getElementById('toDate').value;

        return {
            restaurantId,
            fromUtc: toUtcIsoFromVietnamDate(fromDate, false),
            toUtc: toUtcIsoFromVietnamDate(toDate, true)
        };
    }

    function getDeviceHistoryFilters() {
        const deviceId = document.getElementById('deviceHistoryFilter').value;
        const source = document.getElementById('deviceHistorySourceFilter').value;
        const fromDate = document.getElementById('deviceHistoryFromDate').value;
        const toDate = document.getElementById('deviceHistoryToDate').value;

        return {
            deviceId,
            source,
            fromUtc: toUtcIsoFromVietnamDate(fromDate, false),
            toUtc: toUtcIsoFromVietnamDate(toDate, true)
        };
    }

    async function loadRestaurantOptions() {
        const select = document.getElementById('restaurantFilter');
        try {
            const res = await fetch(poisApi);
            if (!res.ok) return;

            const data = await res.json();
            data.forEach(item => {
                const opt = document.createElement('option');
                opt.value = item.id;
                opt.textContent = `${item.id} - ${item.name}`;
                select.appendChild(opt);
            });
        } catch {
        }
    }

    async function loadWebOnlineUsers() {
        const el = document.getElementById('webOnlineUsers');
        const filters = getFilters();

        try {
            const endpoint = filters.restaurantId
                ? `${webDetailOnlineApi}${buildQuery({ restaurantId: filters.restaurantId })}`
                : webOnlineApi;

            const res = await fetch(endpoint);
            if (!res.ok) {
                el.textContent = '0';
                return;
            }

            const data = await res.json();
            el.textContent = data.online ?? 0;
        } catch {
            el.textContent = '0';
        }
    }

    async function loadOverview() {
        const filters = getFilters();
        const res = await fetch(`${apiBase}/overview${buildQuery(filters)}`, { cache: 'no-store' });
        if (!res.ok) return;

        const data = await res.json();
        latestOverview = data;
        document.getElementById('totalScans').textContent = data.totalScans ?? 0;

        const topDiv = document.getElementById('topRestaurants');
        if (!data.topRestaurants || data.topRestaurants.length === 0) {
            topDiv.innerHTML = '<span class="text-muted">Chưa có dữ liệu</span>';
            return;
        }

        topDiv.innerHTML = data.topRestaurants
            .map((x, i) => `<div>${i + 1}. ${x.restaurantName} - <b>${x.count}</b> lượt</div>`)
            .join('');
    }

    async function loadOnlineUsers() {
        const el = document.getElementById('onlineUsers');

        try {
            const res = await fetch(devicePresenceApi);
            if (!res.ok) {
                el.textContent = '0';
                return;
            }

            const data = await res.json();
            el.textContent = data.count ?? 0;
        } catch {
            el.textContent = '0';
        }
    }

    async function loadDeviceHistoryDeviceOptions() {
        const select = document.getElementById('deviceHistoryFilter');
        const selected = select.value;

        try {
            const filters = getDeviceHistoryFilters();
            const res = await fetch(`${deviceHistoryDevicesApi}${buildQuery(filters)}`, { cache: 'no-store' });
            if (!res.ok) return;

            const data = await res.json();
            const devices = data.devices ?? [];

            select.innerHTML = '<option value="">Tất cả thiết bị</option>';
            devices.forEach(device => {
                const opt = document.createElement('option');
                opt.value = device;
                opt.textContent = device;
                select.appendChild(opt);
            });

            if (selected && devices.includes(selected)) {
                select.value = selected;
            }
        } catch {
        }
    }

    async function loadDeviceHistory() {
        const tableBody = document.querySelector('#deviceHistoryTable tbody');
        const countEl = document.getElementById('deviceHistoryCount');
        const pageInfoEl = document.getElementById('deviceHistoryPageInfo');
        const prevBtn = document.getElementById('btnDeviceHistoryPrev');
        const nextBtn = document.getElementById('btnDeviceHistoryNext');
        const pageSize = Number(document.getElementById('deviceHistoryPageSize').value || 20);
        const filters = getDeviceHistoryFilters();

        try {
            const res = await fetch(`${deviceHistoryApi}${buildQuery({ ...filters, page: deviceHistoryPage, pageSize, _ts: Date.now() })}`, { cache: 'no-store' });
            if (!res.ok) {
                tableBody.innerHTML = '<tr><td colspan="5" class="text-danger text-center">Không tải được dữ liệu</td></tr>';
                countEl.textContent = '0';
                pageInfoEl.textContent = 'Trang 1 / 1';
                prevBtn.disabled = true;
                nextBtn.disabled = true;
                latestDeviceHistory = null;
                return;
            }

            const data = await res.json();
            const items = data.items ?? [];
            latestDeviceHistory = data;
            countEl.textContent = data.totalCount ?? items.length;

            deviceHistoryPage = data.page ?? 1;
            deviceHistoryTotalPages = data.totalPages ?? 1;
            pageInfoEl.textContent = `Trang ${deviceHistoryPage} / ${deviceHistoryTotalPages}`;
            prevBtn.disabled = deviceHistoryPage <= 1;
            nextBtn.disabled = deviceHistoryPage >= deviceHistoryTotalPages;

            if (items.length === 0) {
                tableBody.innerHTML = '<tr><td colspan="5" class="text-muted text-center">Không có lịch sử theo bộ lọc hiện tại</td></tr>';
                return;
            }

            tableBody.innerHTML = items
                .map(x => {
                    const eventType = (x.eventType ?? '').toString().toLowerCase();
                    const badge = eventType === 'connect'
                        ? '<span class="badge bg-success">Connect</span>'
                        : '<span class="badge bg-secondary">Disconnect</span>';
                    const source = (x.source ?? '').toString().toLowerCase() === 'web'
                        ? '<span class="badge bg-info text-dark">Web</span>'
                        : '<span class="badge bg-primary">App</span>';

                    return `<tr>
                        <td>${fmtDateTimeVn(x.eventTimeUtc)}</td>
                        <td>${x.deviceId ?? ''}</td>
                        <td>${source}</td>
                        <td>${badge}</td>
                        <td class="d-none"><code>${x.connectionId ?? ''}</code></td>
                    </tr>`;
                })
                .join('');
        } catch {
            tableBody.innerHTML = '<tr><td colspan="5" class="text-danger text-center">Có lỗi khi tải dữ liệu</td></tr>';
            countEl.textContent = '0';
            pageInfoEl.textContent = 'Trang 1 / 1';
            prevBtn.disabled = true;
            nextBtn.disabled = true;
            latestDeviceHistory = null;
        }
    }

    async function loadTrafficOverview() {
        const renderTrafficChart = (labels, webData, appData) => {
            if (trafficChart) trafficChart.destroy();
            trafficChart = new Chart(document.getElementById('trafficChart'), {
                type: 'line',
                data: {
                    labels,
                    datasets: [
                        {
                            label: 'Web traffic',
                            data: webData,
                            borderColor: '#0ea5e9',
                            backgroundColor: 'rgba(14,165,233,0.15)',
                            tension: 0.25,
                            fill: false
                        },
                        {
                            label: 'App traffic',
                            data: appData,
                            borderColor: '#22c55e',
                            backgroundColor: 'rgba(34,197,94,0.15)',
                            tension: 0.25,
                            fill: false
                        }
                    ]
                }
            });
        };

        try {
            const filters = getFilters();
            const res = await fetch(`${trafficOverviewApi}${buildQuery({ ...filters, _ts: Date.now() })}`, { cache: 'no-store' });
            if (!res.ok) throw new Error('Traffic API failed');

            const data = await res.json();
            latestTrafficOverview = data;

            document.getElementById('trafficAppConnect').textContent = data.app?.connectCount ?? 0;
            document.getElementById('trafficAppDisconnect').textContent = data.app?.disconnectCount ?? 0;
            document.getElementById('trafficWebActive').textContent = data.web?.activeCount ?? 0;
            document.getElementById('trafficUniqueDevices').textContent = `${data.web?.uniqueDevices ?? 0} / ${data.app?.uniqueDevices ?? 0}`;

            const labels = (data.timeline ?? []).map(x => fmtDate(x.date));
            const webData = (data.timeline ?? []).map(x => x.webCount ?? 0);
            const appData = (data.timeline ?? []).map(x => x.appCount ?? 0);
            renderTrafficChart(labels, webData, appData);
        } catch {
            document.getElementById('trafficAppConnect').textContent = '0';
            document.getElementById('trafficAppDisconnect').textContent = '0';
            document.getElementById('trafficWebActive').textContent = '0';
            document.getElementById('trafficUniqueDevices').textContent = '0 / 0';

            const fromDate = document.getElementById('fromDate').value;
            const toDate = document.getElementById('toDate').value;
            const fallbackLabels = [];

            if (fromDate && toDate) {
                let current = new Date(fromDate);
                const end = new Date(toDate);
                while (current <= end) {
                    fallbackLabels.push(fmtDate(current));
                    current.setDate(current.getDate() + 1);
                }
            }

            const zeroSeries = fallbackLabels.map(() => 0);
            renderTrafficChart(fallbackLabels, zeroSeries, zeroSeries);
        }
    }

    async function loadPatterns() {
        const filters = getFilters();
        const res = await fetch(`${apiBase}/patterns${buildQuery({ ...filters, _ts: Date.now() })}`, { cache: 'no-store' });
        if (!res.ok) return;

        const data = await res.json();
        latestPatterns = data;

        const timelineLabels = (data.timeline ?? []).map(x => fmtDate(x.date));
        const timelineValues = (data.timeline ?? []).map(x => x.count);

        const hourlyLabels = (data.hourly ?? []).map(x => x.hour);
        const hourlyValues = (data.hourly ?? []).map(x => x.count);

        if (timelineChart) timelineChart.destroy();
        timelineChart = new Chart(document.getElementById('timelineChart'), {
            type: 'line',
            data: {
                labels: timelineLabels,
                datasets: [{
                    label: 'Lượt quét theo ngày',
                    data: timelineValues,
                    borderColor: '#0d6efd',
                    backgroundColor: 'rgba(13, 110, 253, 0.2)',
                    fill: true,
                    tension: 0.25
                }]
            }
        });

        if (hourlyChart) hourlyChart.destroy();
        hourlyChart = new Chart(document.getElementById('hourlyChart'), {
            type: 'bar',
            data: {
                labels: hourlyLabels,
                datasets: [{
                    label: 'Lượt quét theo giờ',
                    data: hourlyValues,
                    backgroundColor: '#20c997'
                }]
            }
        });
    }

    function getHeatLevel(count, max) {
        if (max <= 0) return 'Vắng';
        const ratio = count / max;
        if (ratio >= 0.66) return 'Đông';
        if (ratio >= 0.33) return 'Bình thường';
        return 'Vắng';
    }

    function heatColor(count, max) {
        const level = getHeatLevel(count, max);
        if (level === 'Đông') return 'rgba(239,68,68,.60)';
        if (level === 'Bình thường') return 'rgba(245,158,11,.35)';
        return 'rgba(59,130,246,.18)';
    }

    async function loadHeatmap() {
        const filters = getFilters();
        const res = await fetch(`${apiBase}/heatmap${buildQuery({ ...filters, _ts: Date.now() })}`, { cache: 'no-store' });
        if (!res.ok) return;

        const data = await res.json();
        latestHeatmap = data;
        const points = data.points ?? [];
        const table = document.getElementById('heatmapTable');

        const max = points.reduce((m, x) => Math.max(m, x.count || 0), 0);

        const map = new Map();
        points.forEach(p => {
            map.set(`${p.dayOfWeek}-${p.hour}`, p);
        });

        let html = '<thead><tr><th>Day / Hour</th>';
        for (let h = 0; h < 24; h++) {
            html += `<th>${h}</th>`;
        }
        html += '</tr></thead><tbody>';

        days.forEach(day => {
            html += `<tr><th>${day}</th>`;
            for (let h = 0; h < 24; h++) {
                const key = `${day}-${h}`;
                const item = map.get(key);
                const count = item?.count ?? 0;
                const level = item?.crowdLevel ?? 'Vắng';
                html += `<td class="heat-cell" style="background:${heatColor(count, max)}" data-day="${day}" data-hour="${h}" data-count="${count}" data-level="${level}">${count}<br/><small>${level}</small></td>`;
            }
            html += '</tr>';
        });

        html += '</tbody>';
        table.innerHTML = html;
    }

    function wireHeatTooltip() {
        const table = document.getElementById('heatmapTable');
        const tooltip = document.getElementById('heatTooltip');

        table.addEventListener('mouseover', (e) => {
            const cell = e.target.closest('.heat-cell');
            if (!cell) return;

            const day = cell.dataset.day;
            const hour = cell.dataset.hour;
            const count = cell.dataset.count;
            const level = cell.dataset.level;

            tooltip.innerHTML = `<div><b>${day}</b> - ${hour}:00</div><div>Lượt quét: <b>${count}</b></div><div>Mức độ: <b>${level}</b></div>`;
            tooltip.style.display = 'block';
        });

        table.addEventListener('mousemove', (e) => {
            if (tooltip.style.display !== 'block') return;
            tooltip.style.left = `${e.clientX + 14}px`;
            tooltip.style.top = `${e.clientY + 14}px`;
        });

        table.addEventListener('mouseout', (e) => {
            if (!e.target.closest('.heat-cell')) return;
            tooltip.style.display = 'none';
        });
    }

    function csvEscape(value) {
        const text = (value ?? '').toString().replaceAll('"', '""');
        return `"${text}"`;
    }

    function exportCsv() {
        const rows = [];
        rows.push(['FoodStreet Dashboard Export', new Date().toISOString()]);
        rows.push([]);

        if (latestOverview) {
            rows.push(['Overview']);
            rows.push(['TotalScans', latestOverview.totalScans ?? 0]);
            rows.push(['RestaurantId', latestOverview.restaurantId ?? 'All']);
            rows.push([]);

            rows.push(['Top Restaurants']);
            rows.push(['RestaurantId', 'RestaurantName', 'Count']);
            (latestOverview.topRestaurants ?? []).forEach(x => {
                rows.push([x.restaurantId, x.restaurantName, x.count]);
            });
            rows.push([]);
        }

        if (latestPatterns) {
            rows.push(['Timeline']);
            rows.push(['Date', 'Count']);
            (latestPatterns.timeline ?? []).forEach(x => rows.push([fmtDate(x.date), x.count]));
            rows.push([]);

            rows.push(['Hourly']);
            rows.push(['Hour', 'Count']);
            (latestPatterns.hourly ?? []).forEach(x => rows.push([x.hour, x.count]));
            rows.push([]);
        }

        if (latestHeatmap) {
            rows.push(['Heatmap']);
            rows.push(['DayOfWeek', 'Hour', 'Count', 'CrowdLevel']);
            (latestHeatmap.points ?? []).forEach(x => rows.push([x.dayOfWeek, x.hour, x.count, x.crowdLevel]));
            rows.push([]);
        }

        if (latestDeviceHistory) {
            rows.push(['Device Connection History']);
            rows.push(['Id', 'DeviceId', 'ConnectionId', 'EventType', 'EventTimeUtc', 'Note']);
            (latestDeviceHistory.items ?? []).forEach(x => rows.push([x.id, x.deviceId, x.connectionId, x.eventType, x.eventTimeUtc, x.note ?? '']));
            rows.push([]);
        }

        if (latestTrafficOverview) {
            rows.push(['Web/App Traffic Overview']);
            rows.push(['AppConnect', 'AppDisconnect', 'AppUniqueDevices', 'WebActive', 'WebUniqueDevices']);
            rows.push([
                latestTrafficOverview.app?.connectCount ?? 0,
                latestTrafficOverview.app?.disconnectCount ?? 0,
                latestTrafficOverview.app?.uniqueDevices ?? 0,
                latestTrafficOverview.web?.activeCount ?? 0,
                latestTrafficOverview.web?.uniqueDevices ?? 0
            ]);
            rows.push([]);

            rows.push(['Traffic Timeline']);
            rows.push(['Date', 'WebCount', 'AppCount']);
            (latestTrafficOverview.timeline ?? []).forEach(x => rows.push([fmtDate(x.date), x.webCount ?? 0, x.appCount ?? 0]));
            rows.push([]);
        }

        const csvContent = rows
            .map(cols => cols.map(csvEscape).join(','))
            .join('\n');

        const blob = new Blob([`\uFEFF${csvContent}`], { type: 'text/csv;charset=utf-8;' });
        const url = URL.createObjectURL(blob);
        const link = document.createElement('a');
        link.href = url;
        link.download = `foodstreet-dashboard-${fmtDate(new Date())}.csv`;
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
        URL.revokeObjectURL(url);
    }

    async function compareDays() {
        const restaurantId = document.getElementById('restaurantFilter').value;
        const dayA = document.getElementById('compareDayA').value;
        const dayB = document.getElementById('compareDayB').value;

        if (!dayA || !dayB) return;

        const query = buildQuery({
            dayA,
            dayB,
            restaurantId,
            _ts: Date.now()
        });

        const res = await fetch(`${apiBase}/compare-days${query}`, { cache: 'no-store' });
        if (!res.ok) return;

        const data = await res.json();
        const labels = (data.dayAHourly ?? []).map(x => x.hour);
        const valuesA = (data.dayAHourly ?? []).map(x => x.count);
        const valuesB = (data.dayBHourly ?? []).map(x => x.count);

        if (compareChart) compareChart.destroy();
        compareChart = new Chart(document.getElementById('compareChart'), {
            type: 'line',
            data: {
                labels,
                datasets: [
                    {
                        label: `Ngày A (${dayA})`,
                        data: valuesA,
                        borderColor: '#fd7e14',
                        backgroundColor: 'rgba(253,126,20,0.2)',
                        fill: false
                    },
                    {
                        label: `Ngày B (${dayB})`,
                        data: valuesB,
                        borderColor: '#6f42c1',
                        backgroundColor: 'rgba(111,66,193,0.2)',
                        fill: false
                    }
                ]
            }
        });
    }

    async function refreshAll() {
        await Promise.all([
            loadOverview(),
            loadOnlineUsers(),
            loadWebOnlineUsers(),
            loadTrafficOverview(),
            loadPatterns(),
            loadHeatmap(),
            loadDeviceHistory(),
            loadDeviceHistoryDeviceOptions()
        ]);
    }

    async function refreshOnlineCountersOnly() {
        await Promise.all([
            loadOverview(),
            loadHeatmap(),
            loadOnlineUsers(),
            loadWebOnlineUsers(),
            loadDeviceHistory()
        ]);
    }

    document.getElementById('btnApply').addEventListener('click', refreshAll);
    document.getElementById('btnReset').addEventListener('click', async () => {
        document.getElementById('restaurantFilter').value = '';
        document.getElementById('fromDate').value = '';
        document.getElementById('toDate').value = '';
        await refreshAll();
    });
    document.getElementById('btnCompare').addEventListener('click', compareDays);
    document.getElementById('btnExportCsv').addEventListener('click', exportCsv);

    document.getElementById('btnApplyDeviceHistory').addEventListener('click', async () => {
        deviceHistoryPage = 1;
        await loadDeviceHistoryDeviceOptions();
        await loadDeviceHistory();
    });

    document.getElementById('btnResetDeviceHistory').addEventListener('click', async () => {
        document.getElementById('deviceHistoryFilter').value = '';
        document.getElementById('deviceHistorySourceFilter').value = '';
        document.getElementById('deviceHistoryFromDate').value = '';
        document.getElementById('deviceHistoryToDate').value = '';
        document.getElementById('deviceHistoryPageSize').value = '20';
        deviceHistoryPage = 1;
        await loadDeviceHistoryDeviceOptions();
        await loadDeviceHistory();
    });

    document.getElementById('deviceHistorySourceFilter').addEventListener('change', async () => {
        deviceHistoryPage = 1;
        await loadDeviceHistoryDeviceOptions();
        await loadDeviceHistory();
    });

    document.getElementById('deviceHistoryPageSize').addEventListener('change', async () => {
        deviceHistoryPage = 1;
        await loadDeviceHistory();
    });

    document.getElementById('btnDeviceHistoryPrev').addEventListener('click', async () => {
        if (deviceHistoryPage <= 1) return;
        deviceHistoryPage -= 1;
        await loadDeviceHistory();
    });

    document.getElementById('btnDeviceHistoryNext').addEventListener('click', async () => {
        if (deviceHistoryPage >= deviceHistoryTotalPages) return;
        deviceHistoryPage += 1;
        await loadDeviceHistory();
    });

    (async function init() {
        const today = new Date();
        const sevenDaysAgo = new Date(today);
        sevenDaysAgo.setDate(today.getDate() - 6);

        document.getElementById('fromDate').value = fmtDate(sevenDaysAgo);
        document.getElementById('toDate').value = fmtDate(today);
        document.getElementById('compareDayA').value = fmtDate(sevenDaysAgo);
        document.getElementById('compareDayB').value = fmtDate(today);
        document.getElementById('deviceHistoryFromDate').value = fmtDate(sevenDaysAgo);
        document.getElementById('deviceHistoryToDate').value = fmtDate(today);

        await loadRestaurantOptions();
        wireHeatTooltip();
        await refreshAll();

        setInterval(refreshOnlineCountersOnly, 2000);
        setInterval(loadTrafficOverview, 10000);
    })();
</script>
