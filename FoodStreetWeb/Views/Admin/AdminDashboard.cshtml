    document.getElementById('btnCompare').addEventListener('click', compareDays);
    document.getElementById('btnExportCsv').addEventListener('click', exportCsv);

    document.getElementById('btnApplyDeviceHistory').addEventListener('click', async () => {
        deviceHistoryPage = 1;
        await loadDeviceHistoryDeviceOptions();
        await loadDeviceHistory();
    });

    document.getElementById('btnResetDeviceHistory').addEventListener('click', async () => {
        document.getElementById('deviceHistoryFilter').value = '';
        document.getElementById('deviceHistorySourceFilter').value = '';
        document.getElementById('deviceHistoryFromDate').value = '';
        document.getElementById('deviceHistoryToDate').value = '';
        document.getElementById('deviceHistoryPageSize').value = '20';
        deviceHistoryPage = 1;
        await loadDeviceHistoryDeviceOptions();
        await loadDeviceHistory();
    });

    document.getElementById('deviceHistorySourceFilter').addEventListener('change', async () => {
        deviceHistoryPage = 1;
        await loadDeviceHistoryDeviceOptions();
        await loadDeviceHistory();
    });

    document.getElementById('deviceHistoryPageSize').addEventListener('change', async () => {
        deviceHistoryPage = 1;
        await loadDeviceHistory();
    });

    document.getElementById('btnDeviceHistoryPrev').addEventListener('click', async () => {
        if (deviceHistoryPage <= 1) return;
        deviceHistoryPage -= 1;
        await loadDeviceHistory();
    });

    document.getElementById('btnDeviceHistoryNext').addEventListener('click', async () => {
        if (deviceHistoryPage >= deviceHistoryTotalPages) return;
        deviceHistoryPage += 1;
        await loadDeviceHistory();
    });

    let scanHubConnection = null;
    let reconnectAttempts = 0;
    let narrationAudio = null;

    async function initSignalR() {
        try {
            if (typeof signalR === 'undefined') {
                console.warn('SignalR client is not available');
                return;
            }

            scanHubConnection = new signalR.HubConnectionBuilder()
                .withUrl('/scanhub', {
                    withCredentials: true
                })
                .withAutomaticReconnect([0, 0, 0, 1000, 3000, 5000])
                .build();

            // 🎙️ LISTEN FOR SCAN & NARRATION EVENTS FROM BOTH APP & WEB
            scanHubConnection.on('OnScanReceived', async (data) => {
                console.log('🎙️ New scan with narration received:', data);

                // Check filter before updating
                const restaurantFilter = document.getElementById('restaurantFilter').value;
                if (!restaurantFilter || restaurantFilter === data.restaurantId.toString()) {
                    // Play narration audio if available
                    if (data.audioUrl) {
                        try {
                            if (narrationAudio) {
                                narrationAudio.pause();
                            }
                            narrationAudio = new Audio(data.audioUrl);
                            narrationAudio.volume = 0.3; // Set volume to 30%
                            await narrationAudio.play();
                            console.log(`▶️ Playing narration for restaurant ${data.restaurantId}`);
                        } catch (err) {
                            console.warn('Failed to play narration:', err);
                        }
                    }

                    // Show notification if narration is playing
                    if (data.restaurantName) {
                        console.log(`📢 Narration playing: ${data.restaurantName}`);
                    }

                    // Update counters
                    await refreshOnlineCountersOnly();
                }
            });

            scanHubConnection.onreconnected(async (connectionId) => {
                console.log('SignalR reconnected:', connectionId);
                reconnectAttempts = 0;
                await resubscribeToScans();
            });

            scanHubConnection.onreconnecting((error) => {
                reconnectAttempts++;
                console.warn(`SignalR reconnecting (attempt ${reconnectAttempts}):`, error);
            });

            scanHubConnection.onclose((error) => {
                console.warn('SignalR closed:', error);
            });

            await scanHubConnection.start();
            console.log('🔌 SignalR connected - Ready to receive narrations from app & web');
            await resubscribeToScans();
        } catch (err) {
            console.error('SignalR connection failed:', err);
            // Continue without SignalR - polling will still work
        }
    }

    async function resubscribeToScans() {
        if (!scanHubConnection || scanHubConnection.state !== signalR.HubConnectionState.Connected) {
            return;
        }

        const restaurantId = document.getElementById('restaurantFilter').value;
        try {
            if (restaurantId) {
                await scanHubConnection.invoke('Subscribe', restaurantId);
                console.log(`✅ Subscribed to restaurant ${restaurantId}`);
            } else {
                await scanHubConnection.invoke('Subscribe', '');
                console.log('✅ Subscribed to all restaurants');
            }
        } catch (err) {
            console.error('Failed to subscribe to scans:', err);
        }
    }

    (async function init() {
        const today = new Date();
        const sevenDaysAgo = new Date(today);
        sevenDaysAgo.setDate(today.getDate() - 6);

        document.getElementById('fromDate').value = fmtDate(sevenDaysAgo);
        document.getElementById('toDate').value = fmtDate(today);
        document.getElementById('compareDayA').value = fmtDate(sevenDaysAgo);
        document.getElementById('compareDayB').value = fmtDate(today);
        document.getElementById('deviceHistoryFromDate').value = fmtDate(sevenDaysAgo);
        document.getElementById('deviceHistoryToDate').value = fmtDate(today);

        await loadRestaurantOptions();
        await refreshAll();

        // Initialize SignalR for real-time narration & scan updates
        await initSignalR();

        // Update subscription when restaurant filter changes
        document.getElementById('restaurantFilter').addEventListener('change', async () => {
            await resubscribeToScans();
            // Also refresh data when filter changes
            await refreshAll();
        });

        // Keep existing polling for fallback
        setInterval(refreshOnlineCountersOnly, 2000);
        setInterval(loadTrafficOverview, 10000);

        // Log that dashboard is ready
        console.log('✅ Dashboard initialized with real-time narration support');
    })();
</script>
