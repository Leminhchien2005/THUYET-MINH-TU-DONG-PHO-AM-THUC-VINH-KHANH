@model FoodStreetWeb.Models.OnlineUsersStatsViewModel

<h2>Thống kê người đang online</h2>

<div style="margin-bottom:16px;">
    <strong>Tổng online:</strong> @Model.TotalOnline
    <br />
    <strong>Online từ quét QR:</strong> @Model.QrOnline
    <br />
    <strong>Du khách:</strong> @Model.GuestOnline
    <br />
    <strong>Admin:</strong> @Model.AdminOnline
    <br />
    <strong>Nhà hàng:</strong> @Model.RestaurantOnline
</div>

<div class="alert alert-info" role="alert">
    Trang tự động làm mới mỗi 3 giây.
</div>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Visitor ID</th>
            <th>Role</th>
            <th>Từ QR</th>
            <th>Path gần nhất</th>
            <th>Last seen</th>
        </tr>
    </thead>
    <tbody>
    @if (Model.Visitors == null || !Model.Visitors.Any())
    {
        <tr>
            <td colspan="5">Chưa có dữ liệu online.</td>
        </tr>
    }
    else
    {
        foreach (var item in Model.Visitors)
        {
            <tr>
                <td>@item.VisitorId</td>
                <td>@item.Role</td>
                <td>@(item.IsFromQr ? "Có" : "Không")</td>
                <td>@item.LastPath</td>
                <td>@item.LastSeenUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</td>
            </tr>
        }
    }
    </tbody>
</table>

<script>
    setTimeout(function () {
        location.reload();
    }, 3000);
</script>
