```html
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FoodStreetWeb</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>

    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom box-shadow mb-3">

            <div class="container-fluid">

                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    FoodStreetWeb
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">

                    <!-- MENU LEFT -->
                    <ul class="navbar-nav flex-grow-1">

                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Home" asp-action="Index">
                                Home
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Home" asp-action="Privacy">
                                Privacy
                            </a>
                        </li>

                        @* ADMIN MENU *@
                        @if (User.Identity.IsAuthenticated && User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Admin" asp-action="AdminDashboard">
                                    Quản lý yêu cầu
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Pois" asp-action="Index">
                                    Quản lý nhà hàng
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Admin" asp-action="Users">
                                    Quản lý tài khoản
                                </a>
                            </li>
                        }

                        @* RESTAURANT OWNER MENU *@
                        @if (User.Identity.IsAuthenticated && User.IsInRole("RestaurantOwner"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Owner" asp-action="OwnerDashboard">
                                    Quán của tôi
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Owner" asp-action="CreateRestaurant">
                                    Thêm quán
                                </a>
                            </li>
                        }

                    </ul>


                    <!-- MENU RIGHT -->
                    <ul class="navbar-nav">

                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <span class="nav-link">
                                    Xin chào @User.Identity.Name
                                </span>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-danger" href="/Account/Logout">
                                    Đăng xuất
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/Account/Login">
                                    Đăng nhập
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/Account/Register">
                                    Đăng ký
                                </a>
                            </li>
                        }

                    </ul>

                </div>

            </div>

        </nav>
    </header>


    <div class="container">

        <main role="main" class="pb-3">
            @RenderBody()
        </main>

    </div>


    <footer class="border-top footer text-muted">

        <div class="container">
            © 2026 - FoodStreetWeb
        </div>

    </footer>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
```
