@model FoodStreetWeb.Models.Poi

<h2>Chi tiết quán</h2>

<p><b>Tên quán:</b> @Model.Name</p>
<p><b>Mô tả:</b> @Model.Description</p>
<p><b>Latitude:</b> @Model.Latitude</p>
<p><b>Longitude:</b> @Model.Longitude</p>
<p><b>Bán kính:</b> @Model.Radius</p>

@if (!string.IsNullOrEmpty(Model.ImageUrl))
{
    <img src="@Model.ImageUrl" width="300" />
}

<br />
<br />

<a asp-action="Requests">Quay lại</a>