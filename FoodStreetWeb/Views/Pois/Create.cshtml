@model FoodStreetWeb.Models.CreatePoiWithFoodsViewModel

@{
    ViewData["Title"] = "Thêm quán ăn";
}

<link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />

<h2>Thêm quán ăn</h2>

<form asp-action="Create" method="post" enctype="multipart/form-data">

    <div class="form-group">
        <label>Tên quán</label>
        <input asp-for="Name" class="form-control" />
    </div>

    <br />

    <!-- SEARCH LOCATION -->
    <div class="form-group">

        <label>Tìm địa chỉ</label>

        <div style="display:flex;gap:10px">

            <input type="text"
                   id="searchLocation"
                   placeholder="Ví dụ: Đại học Thủ Đức"
                   class="form-control" />

            <button type="button"
                    onclick="searchLocationhehe()"
                    class="btn btn-secondary">
                Tìm
            </button>

        </div>

    </div>

    <br />

    <!-- MAP -->
    <div class="form-group">

        <label>Chọn vị trí trên bản đồ</label>

        <div id="map"
             style="height:400px;border:1px solid #ccc"></div>

        <small>Click vào bản đồ để chọn vị trí</small>

    </div>

    <!-- LAT LNG -->
    <input asp-for="Latitude" id="Latitude" type="hidden" />
    <input asp-for="Longitude" id="Longitude" type="hidden" />

    <br />

    <div class="form-group">
        <label>Bán kính (m)</label>
        <input asp-for="Radius"
               id="Radius"
               class="form-control" />
    </div>

    <br />

    <div class="form-group">
        <label>Mô tả</label>
        <input asp-for="Description"
               class="form-control" />
    </div>

    <br />

    <div class="form-group">
        <label>Link ảnh</label>
        <input type="file" name="ImageFile" class="form-control" />
    </div>

    <br />

    <hr />

    <h4>Thêm món ăn</h4>

    <div class="form-group">
        <label>Số món</label>
        <input type="number" id="foodCount" class="form-control" min="1" />
        <button type="button" class="btn btn-secondary mt-2" onclick="generateFoodInputs()">
            Tạo form món ăn
        </button>
    </div>

    <br />

    <div id="foodContainer"></div>

    <button type="submit" class="btn btn-primary">
        Lưu
    </button>

</form>
<div asp-validation-summary="All" class="text-danger"></div>
<p>
    <a asp-action="Index">Quay lại danh sách</a>
</p>


@section Scripts {

    <script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>

    <script>

        var map = L.map('map').setView([10.762622,106.660172],13);

        L.tileLayer(
        'https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',
        {
        attribution:'Map data'
        }).addTo(map);

        var marker;
        var circle;

        // CLICK MAP
        map.on('click',function(e){

        var lat=e.latlng.lat;
        var lng=e.latlng.lng;

        if(marker){
        map.removeLayer(marker);
        }

        marker=L.marker([lat,lng]).addTo(map);

        document.getElementById("Latitude").value=lat;
        document.getElementById("Longitude").value=lng;

        drawRadius(lat,lng);

        });

        // DRAW RADIUS
        function drawRadius(lat,lng){

        var radius=document.getElementById("Radius").value;

        if(circle){
        map.removeLayer(circle);
        }

        if(radius){

        circle=L.circle([lat,lng],{
        radius:radius,
        color:'blue',
        fillOpacity:0.2
        }).addTo(map);

        }

        }

        // UPDATE RADIUS
        document.getElementById("Radius").addEventListener("input",function(){

        if(marker){

        var lat=marker.getLatLng().lat;
        var lng=marker.getLatLng().lng;

        drawRadius(lat,lng);

        }

        });

        // SEARCH LOCATION
        async function searchLocationhehe(){

        var query = document.getElementById("searchLocation").value.trim();

        // kiểm tra có phải tọa độ không
        if(query.includes(",")){

        var parts = query.split(",");

        var lat = parseFloat(parts[0].trim());
        var lng = parseFloat(parts[1].trim());

        if(!isNaN(lat) && !isNaN(lng)){

        map.setView([lat,lng],17);

        if(marker){
        map.removeLayer(marker);
        }

        marker = L.marker([lat,lng]).addTo(map);

        document.getElementById("Latitude").value = lat;
        document.getElementById("Longitude").value = lng;

        drawRadius(lat,lng);

        return;
        }

        }

        // nếu không phải tọa độ thì tìm địa chỉ

        var url =
        "https://nominatim.openstreetmap.org/search?format=json&q="
        + encodeURIComponent(query);

        var response = await fetch(url);
        var data = await response.json();

        if(data.length == 0){
        alert("Không tìm thấy địa điểm");
        return;
        }

        var lat = data[0].lat;
        var lng = data[0].lon;

        map.setView([lat,lng],17);

        if(marker){
        map.removeLayer(marker);
        }

        marker = L.marker([lat,lng]).addTo(map);

        document.getElementById("Latitude").value = lat;
        document.getElementById("Longitude").value = lng;

        drawRadius(lat,lng);

        }

        // CURRENT LOCATION
        // DEFAULT LOCATION (TPHCM)
        var defaultLat = 10.760972;
        var defaultLng = 106.704676;

        // mở map tại vị trí mặc định
        map.setView([defaultLat, defaultLng], 15);

        // ===== FOOD DYNAMIC =====
        function generateFoodInputs() {

        var count = document.getElementById("foodCount").value;
        var container = document.getElementById("foodContainer");

        container.innerHTML = "";

        for (var i = 0; i < count; i++) {

        container.innerHTML += `
        <div style="border:1px solid #ccc;padding:10px;margin-bottom:10px">

        <h5>Món ${i + 1}</h5>

        <input name="Foods[${i}].Name"
        class="form-control mb-2"
        placeholder="Tên món" />

        <input name="Foods[${i}].Price"
        type="number"
        class="form-control mb-2"
        placeholder="Giá" />

        <input name="Foods[${i}].Description"
        class="form-control mb-2"
        placeholder="Mô tả" />

        <input type="file"
        name="Foods[${i}].ImageFile"
        class="form-control mb-2" />

        </div>
        `;
        }
        }

    </script>

}