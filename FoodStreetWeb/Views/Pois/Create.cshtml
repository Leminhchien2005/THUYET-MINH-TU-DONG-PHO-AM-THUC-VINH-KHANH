@model FoodStreetWeb.Models.Poi

<h2>Thêm quán ăn</h2>

<form asp-action="Create" method="post">
    <div>
        <label>Tên quán</label>
        <input asp-for="Name" />
    </div>

    <div>
        <label>Vĩ độ</label>
        <input asp-for="Latitude" />
    </div>

    <div>
        <label>Kinh độ</label>
        <input asp-for="Longitude" />
    </div>

    <div>
        <label>Bán kính (m)</label>
        <input asp-for="Radius" />
    </div>

    <div>
        <label>Mô tả</label>
        <input asp-for="Description" />
    </div>

    <div>
        <label>Link ảnh</label>
        <input asp-for="ImageUrl" />
    </div>

    <br />
    <button type="submit">Lưu</button>
</form>

<p>
    <a asp-action="Index">Quay lại danh sách</a>
</p>