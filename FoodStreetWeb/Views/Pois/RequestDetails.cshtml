{
    <h3>Thông tin quán mới</h3>

    <table class="table">
        <tr>
            <th>Tên</th>
            <td>@Model.Name</td>
        </tr>

        <tr>
            <th>Latitude</th>
            <td>@Model.Latitude</td>
        </tr>

        <tr>
            <th>Longitude</th>
            <td>@Model.Longitude</td>
        </tr>

        <tr>
            <th>Radius</th>
            <td>@Model.Radius</td>
        </tr>

        <tr>
            <th>Description</th>
            <td>@Model.Description</td>
        </tr>
        <tr>
            <th>Ảnh</th>
            <td>
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl"
                         style="width:200px;border-radius:10px" />
                }
            </td>
        </tr>
