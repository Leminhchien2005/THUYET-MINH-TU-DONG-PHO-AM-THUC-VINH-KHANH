                }
            </ul>
        }

    </div>
}

<!-- ===================== DELETE ===================== -->
@if (Model.RequestType == PoiRequestType.Delete)
{
    <h3>Quán sẽ bị xóa</h3>

    <table class="table">
        <tr>
            <th>Tên</th>
            <td>@oldPoi?.Name</td>
        </tr>

        <tr>
            <th>Latitude</th>
            <td>@oldPoi?.Latitude</td>
        </tr>

        <tr>
            <th>Longitude</th>
            <td>@oldPoi?.Longitude</td>
        </tr>

        <tr>
            <th>Radius</th>
            <td>@oldPoi?.Radius</td>
        </tr>

        <tr>
            <th>Description</th>
            <td>@oldPoi?.Description</td>
        </tr>
        <tr>
            <th>Ảnh</th>
            <td>
                @if (!string.IsNullOrEmpty(oldPoi?.ImageUrl))
                {
                    <img src="@oldPoi.ImageUrl"
                         style="width:200px;border-radius:10px" />
                }
            </td>
        </tr>
    </table>

    <h4>Bản đồ quán sẽ bị xóa</h4>
    <div id="mapOld" style="height:350px;border:1px solid #ccc"></div>

    <button class="btn btn-danger" onclick="toggleDeleteFood()">
        Xem món ăn
    </button>

    <div id="foodDelete" style="display:none;margin-top:15px;">

        @if (oldPoi != null)
        {
            <h4>Món ăn</h4>

            <ul class="list-group">
                @foreach (var f in oldPoi.Foods ?? new List<Food>())
                {
                    <li class="list-group-item">

                        <b>@f.Name</b> - @f.Price

                        <br />

                        @if (!string.IsNullOrEmpty(f.ImageUrl))
                        {
                            <img src="@f.ImageUrl"
                                 style="width:120px;height:120px;object-fit:cover;margin-top:5px;border-radius:8px" />
                        }

                    </li>
                }
            </ul>
        }

    </div>
}

<hr />

@if (User.IsInRole("Admin") && Model.Status.ToString().Contains("Pending"))
{
    <a class="btn btn-success"
           asp-action="Approve"
           asp-route-id="@Model.Id">
        Duyệt
    </a>

    <form asp-action="Reject" method="post" style="margin-top:10px;">
        <input type="hidden" name="id" value="@Model.Id" />

        <div class="form-group">
            <label>Lý do từ chối</label>

            <input type="text"
                   name="reason"
                   class="form-control"
                   placeholder="Nhập lý do từ chối...">
        </div>

        <button type="submit" class="btn btn-danger">
            Từ chối
        </button>
    </form>
}

<br />

<a class="btn btn-secondary"
       asp-action="@(User.IsInRole("Admin") ? "AdminRequests" : "Requests")">
    Quay lại
</a>

@section Scripts {

    <script>

        // ==========================
        // MAP QUÁN HIỆN TẠI
        // ==========================

        @if (oldPoi != null)
        {
            <text>

                var oldLat = @oldPoi.Latitude;
                var oldLng = @oldPoi.Longitude;
                var oldRadius = @oldPoi.Radius;

                var mapOld = L.map('mapOld').setView([oldLat, oldLng], 15);

                L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png')
                .addTo(mapOld);

                L.marker([oldLat, oldLng])
                .addTo(mapOld)
                .bindPopup("Quán hiện tại")
                .openPopup();

                L.circle([oldLat, oldLng],{
                radius: oldRadius,
                color:'blue',
                fillOpacity:0.2
                }).addTo(mapOld);

            </text>
        }

        // ==========================
        // MAP YÊU CẦU / QUÁN MỚI
        // ==========================

        var newLat = @Model.Latitude;
        var newLng = @Model.Longitude;
        var newRadius = @Model.Radius;

        var mapNew = L.map('mapNew').setView([newLat, newLng], 15);

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png')
        .addTo(mapNew);

        L.marker([newLat, newLng])
        .addTo(mapNew)
        .bindPopup("Vị trí yêu cầu")
        .openPopup();

        L.circle([newLat, newLng],{
        radius:newRadius,
        color:'red',
        fillOpacity:0.2
        }).addTo(mapNew);

        // ==========================
        // TOGGLE FOOD
        // ==========================

        function toggleOldFoods() {
        var x = document.getElementById("oldFoods");
        x.style.display = (x.style.display === "none" || x.style.display === "")
        ? "block"
        : "none";
        }

        function toggleNewFoods() {
        var x = document.getElementById("newFoods");
        x.style.display = (x.style.display === "none" || x.style.display === "")
        ? "block"
        : "none";
        }

        function toggleCreateFood() {
        var x = document.getElementById("foodCreate");
        x.style.display = (x.style.display === "none" || x.style.display === "")
        ? "block"
        : "none";
        }

        function toggleDeleteFood() {
        var x = document.getElementById("foodDelete");
        x.style.display = (x.style.display === "none" || x.style.display === "")
        ? "block"
        : "none";
        }

    </script>
}