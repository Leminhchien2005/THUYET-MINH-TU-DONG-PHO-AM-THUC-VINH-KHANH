@model FoodStreetWeb.Models.PoiRequest
@using FoodStreetWeb.Models

@{
    ViewData["Title"] = "Chi tiết yêu cầu";
    var oldPoi = ViewBag.OldPoi as Poi;
    var foodRequests = ViewBag.FoodRequests as List<FoodRequest>;
}

<link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>

<h2>Chi tiết yêu cầu</h2>

<hr />

<p><b>Loại yêu cầu:</b> @Model.RequestType</p>
<p><b>Trạng thái:</b> @Model.Status</p>

@if (Model.Status == PoiStatus.Rejected && !string.IsNullOrEmpty(Model.RejectReason))
{
    <div class="alert alert-danger">
        <strong>Lý do từ chối:</strong> @Model.RejectReason
    </div>
}

<p><b>Thời gian gửi:</b> @Model.CreatedAt</p>

<hr />

<h3>Thông tin chủ nhà hàng</h3>

<table class="table">
    <tr>
        <th>Họ tên</th>
        <td>@ViewBag.OwnerName</td>
    </tr>

    <tr>
        <th>Email</th>
        <td>@ViewBag.OwnerEmail</td>
    </tr>

    <tr>
        <th>Số điện thoại</th>
        <td>@ViewBag.OwnerPhone</td>
    </tr>
</table>

<hr />

<!-- ===================== UPDATE ===================== -->
@if (Model.RequestType == PoiRequestType.Update)
{
    <h3>Quán hiện tại</h3>

    <table class="table">
        <tr>
            <th>Tên</th>
            <td>@oldPoi?.Name</td>
        </tr>

        <tr>
            <th>Latitude</th>
            <td>@oldPoi?.Latitude</td>
        </tr>

        <tr>
            <th>Longitude</th>
            <td>@oldPoi?.Longitude</td>
        </tr>

        <tr>
            <th>Radius</th>
            <td>@oldPoi?.Radius</td>
        </tr>

        <tr>
            <th>Description</th>
            <td>@oldPoi?.Description</td>
        </tr>
        <tr>
            <th>Ảnh</th>
            <td>
                @if (!string.IsNullOrEmpty(oldPoi?.ImageUrl))
                {
                    <img src="@oldPoi.ImageUrl"
                         style="width:200px;border-radius:10px" />
                }
            </td>
        </tr>
    </table>

    <h4>Bản đồ quán hiện tại</h4>
    <div id="mapOld" style="height:350px;border:1px solid #ccc"></div>

    <button class="btn btn-primary" onclick="toggleOldFoods()">
        Xem món ăn
    </button>

    <div id="oldFoods" style="display:none;margin-top:15px;">
        <h4>Món ăn hiện tại</h4>

        <ul class="list-group">
            @if (oldPoi != null)
            {
                foreach (var f in oldPoi?.Foods ?? new List<Food>())
                {
                    <li class="list-group-item">

                        <b>@f.Name</b> - @f.Price

                        <br />

                        @if (!string.IsNullOrEmpty(f.ImageUrl))
                        {
                            <img src="@f.ImageUrl"
                                 style="width:120px;height:120px;object-fit:cover;margin-top:5px;border-radius:8px" />
                        }

                    </li>
                }
            }
        </ul>
    </div>

    <h3>Thông tin yêu cầu sửa</h3>

    <table class="table">
        <tr>
            <th>Tên</th>
            <td>@Model.Name</td>
        </tr>

        <tr>
            <th>Latitude</th>
            <td>@Model.Latitude</td>
        </tr>

        <tr>
            <th>Longitude</th>
            <td>@Model.Longitude</td>
        </tr>

        <tr>
            <th>Radius</th>
            <td>@Model.Radius</td>
        </tr>

        <tr>
            <th>Description</th>
            <td>@Model.Description</td>
        </tr>
        <tr>
            <th>Ảnh</th>
            <td>
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl"
                         style="width:200px;border-radius:10px" />
                }
            </td>
        </tr>
    </table>

    <h4>Bản đồ vị trí yêu cầu sửa</h4>
    <div id="mapNew" style="height:350px;border:1px solid #ccc"></div>

    <button class="btn btn-success" onclick="toggleNewFoods()">
        Xem món ăn
    </button>

    <div id="newFoods" style="display:none;margin-top:15px;">
        <h4>Món ăn yêu cầu</h4>

        <ul class="list-group">
            @if (foodRequests != null)
            {
                foreach (var f in foodRequests)
                {
                    <li class="list-group-item">

                        <b>@f.Name</b> - @f.Price

                        <br />

                        @if (!string.IsNullOrEmpty(f.ImageUrl))
                        {
                            <img src="@f.ImageUrl"
                                 style="width:120px;height:120px;object-fit:cover;margin-top:5px;border-radius:8px" />
                        }

                    </li>
                }
            }
        </ul>
    </div>

   }
<!-- ===================== CREATE ===================== -->
