@model IEnumerable<FoodStreetWeb.Models.PoiRequest>

<h2>Yêu cầu đã gửi</h2>

<table class="table">
    <thead>
        <tr>
            <th>Tên quán</th>
            <th>Loại yêu cầu</th>
            <th>Trạng thái</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>

                <td>
                    @item.Name
                </td>

                <td>
                    @if (item.RequestType == FoodStreetWeb.Models.PoiRequestType.Create)
                    {
                        <span>Thêm quán</span>
                    }
                    else if (item.RequestType == FoodStreetWeb.Models.PoiRequestType.Update)
                    {
                        <span>Chỉnh sửa</span>
                    }
                    else if (item.RequestType == FoodStreetWeb.Models.PoiRequestType.Delete)
                    {
                        <span>Xóa quán</span>
                    }
                </td>

                <td>
                    @if (item.Status == FoodStreetWeb.Models.PoiStatus.PendingCreate)
                    {
                        <span>Chờ duyệt</span>
                    }
                    else if (item.Status == FoodStreetWeb.Models.PoiStatus.PendingUpdate)
                    {
                        <span>Chờ duyệt</span>
                    }
                    else if (item.Status == FoodStreetWeb.Models.PoiStatus.Approved)
                    {
                        <span>Đã duyệt</span>
                    }
                    else if (item.Status == FoodStreetWeb.Models.PoiStatus.Rejected)
                    {
                        <span>Bị từ chối</span>
                    }
                </td>

            </tr>
        }
    </tbody>
</table>