@model FoodStreetWeb.Models.Poi
@{
    ViewData["Title"] = Model.Name;
    // Dùng Layout chung của Web nếu có. Nếu không thì Layout = null;
    // Layout = "_Layout";
}

<div class="container mt-5">
    <div class="row">
        <!-- Ảnh cover quán -->
        <div class="col-md-6 mb-4">
            <img src="@Model.ImageUrl" alt="@Model.Name" class="img-fluid rounded shadow" style="width: 100%; height: auto; object-fit: cover;" onerror="this.src='https://via.placeholder.com/600x400';">
        </div>

        <!-- Thông tin quán -->
        <div class="col-md-6">
            <h1 class="display-5 font-weight-bold mb-3">@Model.Name</h1>

            <hr />

            <h4 class="mt-4">Giới thiệu</h4>
            <p>@Model.Description</p>

            <div class="d-flex gap-3 mt-4">
                <a href="/restaurant/@Model.Id" class="btn btn-primary d-flex align-items-center">
                    📱 Mở bằng ứng dụng
                </a>
                <button class="btn btn-outline-secondary d-flex align-items-center">
                    🍽️ Xem menu
                </button>
            </div>
        </div>
    </div>
</div>