@model FoodStreetWeb.Models.Poi
@{
    ViewData["Title"] = Model.Name;
}

<div class="container mt-5">
    <div class="row">
        
        <!-- Ảnh -->
        <div class="col-md-6 mb-4">
            <img src="@Model.ImageUrl"
                 alt="@Model.Name"
                 class="img-fluid rounded shadow"
                 style="width: 100%; height: 400px; object-fit: cover;"
                 onerror="this.src='https://images.unsplash.com/photo-1504674900247-0877df9cc836';">
        </div>

        <!-- Info -->
        <div class="col-md-6">
            <h1 class="fw-bold">@Model.Name</h1>

            <!-- Rating + Price -->
            <div class="mb-2">
                ⭐ 4.5 | 💰 50k - 150k
            </div>

            <!-- Địa chỉ -->
            <p class="text-muted">
                📍 Latitude: @Model.Latitude, Longitude: @Model.Longitude
            </p>

            <hr />

            <h5>Giới thiệu</h5>
            <p>@Model.Description</p>

            <!-- Buttons -->
            <div class="d-flex gap-3 mt-4">
                <a href="/restaurant/@Model.Id"
                   class="btn btn-primary">
                    📱 Mở bằng ứng dụng
                </a>

                <a href="/menu/@Model.Id"
                   class="btn btn-outline-secondary">
                    🍽️ Xem menu
                </a>
            </div>
        </div>
    </div>
</div>